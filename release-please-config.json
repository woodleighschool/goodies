{
  "$schema": "https://raw.githubusercontent.com/release-please-oss/release-please/main/schemas/config.json",
  "pull-request-title-pattern": "chore(release):${component} ${version}",
  "group-pull-request-title-pattern": "chore(release): ${branch}",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": true,
  "tag-separator": "/",
  "separate-pull-requests": false,
  "packages": {
    "auth": {
      "component": "auth",
      "release-type": "go"
    },
    "pglock": {
      "component": "pglock",
      "release-type": "go"
    },
    "bloby": {
      "component": "bloby",
      "release-type": "go"
    },
    "packages/authz": {
      "component": "authz",
      "release-type": "node"
    },
    "packages/bloby-client": {
      "component": "bloby-client",
      "release-type": "node"
    }
  }
}
