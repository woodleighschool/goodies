{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  "packageRules": [
    {
      "matchManagers": ["gomod", "npm"],
      "matchDepTypes": ["require", "dependencies", "peerDependencies", "optionalDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "runtime dependencies",
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "tooling dependencies",
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": ["github-actions", "mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "tooling dependencies",
      "semanticCommitType": "chore"
    }
  ]
}
