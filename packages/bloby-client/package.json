{
  "name": "@woodleighschool/bloby-client",
  "version": "1.3.0",
  "description": "Headless browser transfers for Bloby direct and multipart uploads.",
  "homepage": "https://github.com/woodleighschool/goodies/tree/main/packages/bloby-client",
  "bugs": "https://github.com/woodleighschool/goodies/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodleighschool/goodies.git",
    "directory": "packages/bloby-client"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && pnpm run typecheck",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run test",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@aws-sdk/crc64-nvme": "^3.972.41",
    "@stablelib/sha256": "^2.0.1",
    "p-map": "^7.0.8",
    "p-retry": "^8.0.1",
    "uint8array-extras": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
